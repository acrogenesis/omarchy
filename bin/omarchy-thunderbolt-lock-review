#!/bin/bash

# omarchy:hidden=true
# omarchy:summary=Review Thunderbolt devices or forget saved approvals
# omarchy:args=[--manage]

set -euo pipefail
source "$OMARCHY_PATH/install/helpers/thunderbolt-lock.sh"
[[ -e $TB_MARKER && -e $TB_APPROVAL ]] || { echo "Thunderbolt approval while unlocked is disabled."; exit 0; }
action="Review blocked devices"
if (( $# == 1 )) && [[ $1 == "--manage" ]]; then
  action=$(gum choose --header "Thunderbolt Devices" "Review blocked devices" "Forget an approved device") || exit 0
elif (( $# != 0 )); then
  exit 64
fi
if [[ $action == "Forget an approved device" ]]; then
  inventory=$(sudo /usr/bin/omarchy-thunderbolt-lock-approve list)
else
  snapshot=$(tb_public_snapshot)
  inventory=$(jq -c '.devices[] | select((.status=="connected" or .status=="auth-error") and (.flags | contains("nopcie") | not)) | .identity' <<<"$snapshot")
fi
[[ -n $inventory ]] || { echo "No matching Thunderbolt devices."; exit 0; }
mapfile -t devices <<<"$inventory"
choices=()
for index in "${!devices[@]}"; do
  summary=$(jq -r '[.Vendor,.Name,.Uid] | join(" / ")' <<<"${devices[index]}" | LC_ALL=C tr -cd '[:print:]')
  choices+=("$((index + 1)). ${summary:0:110}")
done
selected=$(gum choose --header "$action" -- "${choices[@]}") || exit 0
index=${selected%%.*}
[[ $index =~ ^[0-9]+$ ]] && (( index > 0 && index <= ${#devices[@]} )) || exit 1
identity=${devices[index-1]}
printf '%s\n' "$selected"
if [[ $action == "Forget an approved device" ]]; then
  gum confirm "Forget approval for future connections? Safely disconnect the device to end its current access." || exit 0
  operation=forget
else
  echo "Device names and identities can be forged. Approve only a device you recognize."
  choice=$(gum choose "Always allow" "Keep blocked") || exit 0
  [[ $choice == "Always allow" ]] || exit 0
  operation=always
fi
if sudo /usr/bin/omarchy-thunderbolt-lock-approve "$operation" "$identity" >/dev/null; then
  if [[ $operation == "forget" ]]; then
    echo "Approval forgotten. Safely disconnect the device to end its current access."
  else
    echo "Thunderbolt device approved."
  fi
else
  echo "The change was not confirmed. Unlock the screen and review the current device again." >&2
  exit 1
fi

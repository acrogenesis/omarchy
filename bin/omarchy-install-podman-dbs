#!/bin/bash

# omarchy:summary=Install one of the supported databases in a Podman container with the suitable development options.
# omarchy:args=[MySQL|PostgreSQL|Redis|MongoDB|MariaDB|MSSQL...]

set -euo pipefail

options=("MySQL" "PostgreSQL" "Redis" "MongoDB" "MariaDB" "MSSQL")

if (( $# == 0 )); then
  choices=$(printf "%s\n" "${options[@]}" | gum choose --header "Select database (return to install, esc to cancel)") || exit 0
else
  choices="$@"
fi

if [[ -n $choices ]]; then
  for db in $choices; do
    echo "Installing $db..."
    case $db in
    MySQL) podman run -d --restart unless-stopped -p "127.0.0.1:3306:3306" --name=mysql8 -e MYSQL_ROOT_PASSWORD= -e MYSQL_ALLOW_EMPTY_PASSWORD=true docker.io/library/mysql:8.4 ;;
    PostgreSQL) podman run -d --restart unless-stopped -p "127.0.0.1:5432:5432" --name=postgres18 -e POSTGRES_HOST_AUTH_METHOD=trust docker.io/library/postgres:18 ;;
    MariaDB) podman run -d --restart unless-stopped -p "127.0.0.1:3306:3306" --name=mariadb11 -e MARIADB_ROOT_PASSWORD= -e MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=true docker.io/library/mariadb:11.8 ;;
    Redis) podman run -d --restart unless-stopped -p "127.0.0.1:6379:6379" --name=redis docker.io/library/redis:7 ;;
    MongoDB) podman run -d --restart unless-stopped -p "127.0.0.1:27017:27017" --name mongodb -e MONGO_INITDB_ROOT_USERNAME=admin -e MONGO_INITDB_ROOT_PASSWORD=admin123 docker.io/library/mongo:noble ;;
    MSSQL) podman run -d --restart unless-stopped -p "127.0.0.1:1433:1433" --name mssql -e MSSQL_PID=Developer -e ACCEPT_EULA=Y -e "MSSQL_SA_PASSWORD=@dmin123" mcr.microsoft.com/mssql/server:2022-CU12-ubuntu-22.04 ;;
    *) echo "Unknown database: $db" >&2; exit 1 ;;
    esac
  done
else
  echo "No databases selected for installation."
fi
